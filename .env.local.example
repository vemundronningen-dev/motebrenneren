# Hemmelig – inneholder passord, skal ALDRI ha NEXT_PUBLIC_-prefiks eller
# nås fra klientkode. Kun brukt server-side (se src/lib/db/client.ts).
#
# Finn/lag denne i Neon-dashboardet -> Connection Details. Bruk gjerne
# "pooled connection"-varianten (verten inneholder "-pooler"), siden hver
# spørring likevel går over HTTP via @neondatabase/serverless.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require
