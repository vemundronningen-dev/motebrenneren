# Hemmelig – inneholder passord, skal ALDRI ha NEXT_PUBLIC_-prefiks eller
# nås fra klientkode. Kun brukt server-side (se src/lib/db/client.ts).
#
# Finn/lag denne i Neon-dashboardet -> Connection Details. Bruk gjerne
# "pooled connection"-varianten (verten inneholder "-pooler"), siden hver
# spørring likevel går over HTTP via @neondatabase/serverless.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# ---------------------------------------------------------------------------
# Møteboten ("inviter gronntorsk@motebrenneren.no") - valgfritt. Uten disse
# virker resten av appen som før. Se README.md -> "Møteboten".
# ---------------------------------------------------------------------------

# Adressen folk legger til i møteinvitasjonen (vises på nettsiden).
NEXT_PUBLIC_BOT_EMAIL=gronntorsk@motebrenneren.no

# Recall.ai: API-nøkkel og region (velg EU for norske brukere).
RECALL_API_KEY=
RECALL_REGION=eu-central-1
# "Verification secret" fra Recall-dashboardet (Webhooks), starter med whsec_
RECALL_WEBHOOK_SECRET=

# Lang tilfeldig streng du finner på selv. Legges til i Postmark sin
# inbound-webhook-URL: https://motebrenneren.no/api/inbound-email?token=DENNE
INBOUND_EMAIL_TOKEN=

# Valgfritt: Postmark "Server API token" for å sende bekreftelses-e-post.
POSTMARK_SERVER_TOKEN=
BOT_EMAIL_FROM="Møtebrenneren <gronntorsk@motebrenneren.no>"
