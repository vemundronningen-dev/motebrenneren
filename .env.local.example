# Offentlige (kan eksponeres i nettleseren)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Hemmelig – KUN server-side. Aldri prefiks med NEXT_PUBLIC_.
# Brukes av API-rutene under src/app/api/meetings/** til å opprette/endre
# live_meetings-rader og verifisere host_token, uten å gå via RLS.
# Finnes i Supabase-dashboardet under Project Settings -> API -> service_role.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
